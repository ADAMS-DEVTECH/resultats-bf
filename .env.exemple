# Copier ce fichier en .env puis adapter les valeurs :  cp .env.exemple .env
# .env est ignoré par Git. Ne mettez JAMAIS de vrai mot de passe ici.
# N'utilisez pas d'apostrophe (') dans les mots de passe.

# Numéro de groupe (1 à 8) -> sous-réseau 192.168.(55+GROUPE).0/24
GROUPE=1

# Nombre de serveurs applicatifs (2 à 9). Changez cette seule valeur pour scaler.
NB_APP=2

# PostgreSQL
DB_NAME=resultats
DB_USER=appuser
DB_PASSWORD=changez_moi

# Utilisateur de réplication (bdd1 -> bdd2)
REPL_USER=replicator
REPL_PASSWORD=changez_moi_aussi

# Extensions : 1 = activée, 0 = désactivée
E1_LB2=0
E2_OBS=0

# Extension E2 (Grafana)
GRAFANA_ADMIN_PASSWORD=changez_moi_encore
